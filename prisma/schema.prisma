generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Paramètres d'émetteur — 1:1 avec le userId Clerk
model Settings {
  id           String   @id @default(cuid())
  userId       String   @unique
  onboarded    Boolean  @default(false)
  locale       String   @default("es")
  nombre       String   @default("")
  nif          String   @default("")
  direccion    String   @default("")
  ciudad       String   @default("")
  cp           String   @default("")
  email        String   @default("")
  activity     String   @default("")
  defaultAsset String   @default("USDT")
  wallets      Json
  seriesPrefix String
  nextSeq      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  userId       String
  id           String
  brand        String
  country      String  @default("")
  countryCode  String  @default("")
  address      String  @default("")
  taxId        String  @default("")
  companyRegNo String?
  email        String  @default("")
  notes        String  @default("")
  horsUE       Boolean @default(true)
  createdAt    String  @default("")

  @@id([userId, id])
  @@index([userId])
}

model Invoice {
  userId      String
  id          String
  number      String?
  status      String
  clientId    String
  issueDate   String  @default("")
  serviceDate String  @default("")
  dueDate     String  @default("")
  cobroDate   String  @default("")
  items       Json
  notes       String  @default("")
  irpfRate    Float   @default(0)
  payment     Json?
  /// Justificatif de paiement crypto (métadonnées JSON ; les pièces jointes sont dans ProofFile)
  cryptoProof Json?
  huella      String  @default("")
  createdAt   String  @default("")
  updatedAt   String  @default("")

  @@id([userId, id])
  @@index([userId])
}

/// Pièce jointe (capture / PDF) d'un justificatif crypto — stockée à part pour ne pas alourdir /api/me.
/// Supprimée avec la facture (voir saveUserDatabase).
model ProofFile {
  userId    String
  id        String
  invoiceId String
  name      String
  mime      String
  size      Int
  data      String // contenu en base64 (sans préfixe data:)
  createdAt DateTime @default(now())

  @@id([userId, id])
  @@index([userId, invoiceId])
}

/// Gasto deducible (factura de proveedor). La pièce jointe est dans ProofFile (invoiceId = id du gasto).
model Expense {
  userId        String
  id            String
  date          String  @default("")
  supplier      String  @default("")
  supplierNif   String  @default("")
  invoiceNo     String  @default("")
  concept       String  @default("")
  category      String  @default("otros")
  base          Float   @default(0)
  ivaRate       String  @default("21")
  ivaAmount     Float   @default(0)
  total         Float   @default(0)
  affectPct     Float   @default(100)
  ivaDeductible Boolean @default(true)
  inversionSujetoPasivo Boolean @default(false)
  paisProveedor String  @default("ES")
  rcRate        Float   @default(21)
  file          Json?
  notes         String  @default("")
  createdAt     String  @default("")
  updatedAt     String  @default("")

  @@id([userId, id])
  @@index([userId])
}
